{
  "title": "With Tab: j=Kana, l=Eisuu, Tab alone=Tab",
  "rules": [
    {
      "description": "Tab alone=Tab, Tab+j=Kana, Tab+l=Eisuu",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "tab", "modifiers": { "optional": ["any"] } },
          "to_if_alone": [ { "key_code": "tab" } ],
          "conditions": [ { "type": "variable_if", "name": "tab_combo", "value": 0 } ]
        },

        {
          "type": "basic",
          "from": {
            "simultaneous": [ { "key_code": "tab" }, { "key_code": "j" } ],
            "simultaneous_options": {
              "detect_key_down_uninterruptedly": false,
              "key_down_order": "insensitive",
              "key_up_order": "insensitive",
              "to_after_key_up": []
            },
            "modifiers": { "optional": ["any"] }
           },
          "to": [
            { "set_variable": { "name": "tab_combo", "value": 1 } },
            { "key_code": "japanese_kana" },
            { "set_variable": { "name": "tab_combo", "value": 0 } }
          ]
        },

        {
          "type": "basic",
          "from": {
            "simultaneous": [ { "key_code": "tab" }, { "key_code": "l" } ],
            "simultaneous_options": {
              "detect_key_down_uninterruptedly": false,
              "key_down_order": "insensitive",
              "key_up_order": "insensitive",
              "to_after_key_up": []
            },
            "modifiers": { "optional": ["any"] }
           },
          "to": [
            { "set_variable": { "name": "tab_combo", "value": 1 } },
            { "key_code": "japanese_eisuu" },
            { "set_variable": { "name": "tab_combo", "value": 0 } }
          ]
        }
      ]
    }
  ]
}
