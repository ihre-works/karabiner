{
  "title": "英数キー",
  "rules": [
    {
      "description": "英数 Only -> Escape / 英数 + ? -> Ctrl",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_eisuu",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200
          },
          "to_if_alone": [
            { "key_code": "escape" }
          ],
          "to": [
            { "key_code": "left_control" }
          ]
        }
      ]
    },
    {
      "description": "英数 Only -> EISU,Escape / 英数 + ? -> Ctrl",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_eisuu",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200
          },
          "to_if_alone": [
            { "key_code": "japanese_eisuu" },
            { "key_code": "escape" }
          ],
          "to": [
            { "key_code": "left_control" }
          ]
        }
      ]
    },
    {
      "description": "英数 Only -> EISU / 英数 + ? -> Ctrl+Shift",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_eisuu"
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200
          },
          "to_if_alone": [
            { "key_code": "japanese_eisuu" }
          ],
          "to": [
            {
              "key_code": "left_control",
              "modifiers": [ "left_shift" ]
            }
          ]
        }
      ]
    },
    {
      "description": "英数 Only -> EISU,Escape / 英数 + ? -> Ctrl+Shift",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_eisuu"
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200
          },
          "to_if_alone": [
            { "key_code": "japanese_eisuu" },
            { "key_code": "escape" }
          ],
          "to": [
            {
              "key_code": "left_control",
              "modifiers": [ "left_shift" ]
            }
          ]
        }
      ]
    }
  ]
}
