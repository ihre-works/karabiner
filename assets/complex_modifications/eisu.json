{
  "title": "Eisuu: alone=Escape, with other keys=Ctrl",
  "rules": [
    {
      "description": "英数キー単押しで Escape、同時押しで Ctrl",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_eisuu",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            { "key_code": "left_control" }
          ],
          "to_if_alone": [
            { "key_code": "japanese_eisuu" },
            { "key_code": "escape" }
          ]
        }
      ]
    }
  ]
}
