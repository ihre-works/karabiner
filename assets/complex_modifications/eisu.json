{
  "title": "英数キー",
  "rules": [
    {
      "description": "英数キー単押しで Escape、同時押しで Ctrl",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_eisuu",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            { "key_code": "left_control" }
          ],
          "to_if_alone": [
            { "key_code": "escape" }
          ]
        }
      ]
    },
    {
      "description": "英数キー単押しで EISU+Escape、同時押しで Ctrl",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_eisuu",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            { "key_code": "left_control" }
          ],
          "to_if_alone": [
            { "key_code": "japanese_eisuu" },
            { "key_code": "escape" }
          ]
        }
      ]
    },
    {
      "description": "英数キー短押しで EISU、同時押しで Ctrl+Shift",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_eisuu"
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200
          },
          "to_if_alone": [
            { "key_code": "japanese_eisuu" }
          ],
          "to_if_held_down": [
            {
              "key_code": "left_control",
              "modifiers": [ "left_shift" ]
            }
          ]
        }
      ]
    },
    {
      "description": "英数キー短押しで EISU+Escape、同時押しで Ctrl+Shift",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_eisuu"
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200
          },
          "to_if_alone": [
            { "key_code": "japanese_eisuu" },
            { "key_code": "escape" }
          ],
          "to_if_held_down": [
            {
              "key_code": "left_control",
              "modifiers": [ "left_shift" ]
            }
          ]
        }
      ]
    }
  ]
}
