{
  "title": "Finder Control",
  "rules": [
    {
      "description": "Finder: Ctrl+Fn+I/O -> Shift+Ctrl+Tab / Ctrl+Tab",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "o", "modifiers": { "mandatory": ["fn", "left_control"] }
          },
          "to": [
            { "key_code": "tab", "modifiers": ["left_control"] }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^net\\.sourceforge\\.skim-app\\.skim$",
                "^com\\.apple\\.finder$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "i", "modifiers": { "mandatory": ["fn", "left_control"] }
          },
          "to": [
            { "key_code": "tab", "modifiers": ["left_control", "left_shift"] }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^net\\.sourceforge\\.skim-app\\.skim$",
                "^com\\.apple\\.finder$"
              ]
            }
          ]
        }
      ]
    }
  ]
}

