{
    "title": "Ctrl",
    "rules": [
        {
            "description": "LCtrl+H -> DeleteOrBackspace",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "h", "modifiers": { "mandatory": [ "left_control" ], "optional": [ "any" ] } },
                    "to": [ { "key_code": "delete_or_backspace" } ]
                }
            ]
        },
        {
            "description": "LCtrl+M -> ReturnOrEnter",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "m", "modifiers": { "mandatory": [ "left_control" ], "optional": [ "any" ] } },
                    "to": [ { "key_code": "return_or_enter" } ]
                }
            ]
        },
        {
            "description": "LCtrl+[ -> 英数, ESC",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "open_bracket", "modifiers": { "mandatory": [ "left_control" ], "optional": [ "any" ] } },
                    "to": [ { "key_code": "japanese_eisuu" }, { "key_code": "escape" } ]
                }
            ]
        }
    ]
}
