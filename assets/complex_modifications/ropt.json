{
    "title": "Right Option",
    "rules": [
        {
            "description": "ROpt Only -> 英数,ESC",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "right_option", "modifiers": { "optional": [ "any" ] } },
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 200
                    },
                    "to": [ { "key_code": "right_option", "lazy": true } ],
                    "to_if_alone": [
                        { "key_code": "japanese_eisuu" },
                        { "key_code": "escape" }
                    ]
                }
            ]
        },
        {
            "description": "ROpt+SPC -> 英数,ESC",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "spacebar",
                        "modifiers": {
                            "mandatory": [ "right_option" ]
                        }
                    },
                    "to": [
                        { "key_code": "japanese_eisuu" },
                        { "key_code": "escape" }
                    ]
                }
            ]
        }
    ]
}
