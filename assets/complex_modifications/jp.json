{
    "title": "日本語コントロール",
    "rules": [
        {
            "description": "Fn ONLY -> かな\n英数 ONLY -> 英数",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "fn", "modifiers": { "optional": [ "any" ] } },
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 200
                    },
                    "to": [
                        { "key_code": "fn", "lazy": true }
                    ],
                    "to_if_alone": [
                        { "key_code": "japanese_kana" }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "japanese_eisuu"
                    },
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 200
                    },
                    "to_if_alone": [
                        { "key_code": "japanese_eisuu" }
                    ],
                    "to_if_held_down": [
                        { "key_code": "left_control", "modifiers": [ "left_shift" ] }
                    ]
                }
            ]
        },
        {
            "description": "Fn ONLY -> かな, \nRControl ONLY -> 英数",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "fn", "modifiers": { "optional": [ "any" ] } },
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 200
                    },
                    "to": [
                        { "key_code": "fn", "lazy": true }
                    ],
                    "to_if_alone": [
                        { "key_code": "japanese_kana" }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "right_control"
                    },
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 200
                    },
                    "to_if_alone": [
                        { "key_code": "japanese_eisuu" }
                    ],
                    "to_if_held_down": [
                        { "key_code": "right_control", "modifiers": [ "left_shift" ] }
                    ]
                }
            ]
        },
        {
            "description": "ROpt+J -> かな\nROpt+; -> 英数\nROpt+L -> Shift + 英数\nROpt+K -> Shift + かな",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "j",
                        "modifiers": {
                            "mandatory": [ "right_option" ],
                            "optional": [ "any" ]
                        }
                    },
                    "to": { "key_code": "japanese_kana" }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "semicolon",
                        "modifiers": { "mandatory": [ "right_option" ], "optional": [ "any" ] }
                    },
                    "to": { "key_code": "japanese_eisuu" }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "l",
                        "modifiers": { "mandatory": [ "right_option" ] }
                    },
                    "to": { "key_code": "japanese_eisuu", "modifiers": [ "shift" ] }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "k",
                        "modifiers": { "mandatory": [ "right_option" ] }
                    },
                    "to": { "key_code": "japanese_kana", "modifiers": [ "shift" ] }
                }
            ]
        },
        {
            "description": "LCtrl+J -> かな\nLCtrl+; -> 英数",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "j",
                        "modifiers": {
                            "mandatory": [ "left_control" ],
                            "optional": [ "any" ]
                        }
                    },
                    "to": { "key_code": "japanese_kana" }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "semicolon",
                        "modifiers": {
                            "mandatory": [ "left_control" ],
                            "optional": [ "any" ]
                        }
                    },
                    "to": { "key_code": "japanese_eisuu" }
                }
            ]
        },
	{
            "description": "LCtrl+J -> かな\nLCtrl+; -> 英数\nLCtrl+L -> Shift + 英数\nLCtrl+K -> Shift + かな",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "j",
                        "modifiers": {
                            "mandatory": [ "left_control" ],
                            "optional": [ "any" ]
                        }
                    },
                    "to": { "key_code": "japanese_kana" }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "semicolon",
                        "modifiers": {
                            "mandatory": [ "left_control" ],
                            "optional": [ "any" ]
                        }
                    },
                    "to": { "key_code": "japanese_eisuu" }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "l",
                        "modifiers": {
                            "mandatory": [ "left_control" ]
                        }
                    },
                    "to": { "key_code": "japanese_eisuu", "modifiers": [ "shift" ] }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "k",
                        "modifiers": {
                            "mandatory": [ "left_control" ]
                        }
                    },
                    "to": { "key_code": "japanese_kana", "modifiers": [ "shift" ] }
                }
            ]
        },
        {
            "description": "ROpt+J -> Ctrl+J\nROpt+; -> Ctrl+;\nROpt+L -> Ctrl+L\nROpt+K -> Ctrl+K",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "j",
                        "modifiers": {
                            "mandatory": [ "right_option" ],
                            "optional": [ "any" ]
                        }
                    },
                    "to": { "key_code": "j", "modifiers": [ "control" ] }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "semicolon",
                        "modifiers": {
                            "mandatory": [ "right_option" ],
                            "optional": [ "any" ]
                        }
                    },
                    "to": { "key_code": "semicolon", "modifiers": [ "control" ] }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "l",
                        "modifiers": {
                            "mandatory": [ "right_option" ],
                            "optional": [ "any" ]
                        }
                    },
                    "to": { "key_code": "l", "modifiers": [ "control" ] }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "k",
                        "modifiers": {
                            "mandatory": [ "right_option" ]
                        }
                    },
                    "to": { "key_code": "k", "modifiers": [ "control" ] }
                }
            ]
        }
    ]
}
