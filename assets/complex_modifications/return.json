{
    "title": "With Return",
    "rules": [
        {
            "description": "Return を他のキーと同時押しで right_control",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "return_or_enter", "modifiers": { "optional": [ "any" ] } },
                    "to": [ { "key_code": "right_control", "lazy": true } ],
                    "to_if_alone": [ { "key_code": "return_or_enter" } ]
                }
            ]
        },
        {
            "description": "LCtrl+J/L -> かな/ABC",
            "manipulators": [
                {
                    "type": "basic",
                    "from": { "key_code": "j", "modifiers": { "mandatory": [ "left_control" ] } },
                    "to": [ { "key_code": "japanese_kana" } ]
                },
                {
                    "type": "basic",
                    "from": { "key_code": "l", "modifiers": { "mandatory": [ "left_control" ] } },
                    "to": [ { "key_code": "japanese_eisuu" } ]
                }
            ]
        }
    ]
}
